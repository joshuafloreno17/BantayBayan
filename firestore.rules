rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Official = may document sa officials/{uid}.
    // Sa Firebase console lang ito ginagawa.
    function isOfficial() {
      return signedIn()
        && exists(/databases/$(database)/documents/officials/$(request.auth.uid));
    }

    function ownsNewDoc() {
      return signedIn() && request.resource.data.userId == request.auth.uid;
    }

    function validCoords(lat, lng) {
      return lat is number && lng is number
        && lat >= -90 && lat <= 90
        && lng >= -180 && lng <= 180;
    }

    // Listahan ng officials. Makikita lang ng user ang sarili niyang entry,
    // at walang makakapag-write mula sa website.
    match /officials/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Profile ng resident. Bawal mag-set ng ibang role maliban sa "resident".
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isOfficial());
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'resident';
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == resource.data.role;
      allow delete: if isOfficial();
    }

    match /reports/{id} {
      allow read: if true;
      allow create: if ownsNewDoc()
        && request.resource.data.status == 'Pending'
        && request.resource.data.type in ['garbage', 'flooding', 'canal', 'streetlight', 'others']
        && request.resource.data.purok is string
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 1000
        && request.resource.data.photo is string
        && request.resource.data.photo.size() < 900000
        && validCoords(request.resource.data.latitude, request.resource.data.longitude);
      allow update, delete: if isOfficial();
    }

    // Pangalan at contact ng nag-report. Officials lang ang nakakabasa
    // (Data Privacy Act, RA 10173).
    match /reportContacts/{id} {
      allow create: if signedIn()
        && request.resource.data.reportId == id
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100
        && request.resource.data.contact is string
        && request.resource.data.contact.size() <= 200;
      allow read, update, delete: if isOfficial();
    }

    match /floodReports/{id} {
      allow read: if true;
      allow create: if ownsNewDoc()
        && request.resource.data.floodLevel in ['ankle', 'knee', 'waist']
        && request.resource.data.purok is string
        && request.resource.data.photoUrl is string
        && request.resource.data.photoUrl.size() < 900000
        && validCoords(request.resource.data.latitude, request.resource.data.longitude);
      allow update, delete: if isOfficial();
    }
  }
}
